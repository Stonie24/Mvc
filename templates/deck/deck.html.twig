{% extends "base.html.twig" %}

{% block title %}Card Deck{% endblock %}

{% block body %}
<div class="container">
    <h1>Card Deck</h1>

<p>Cards remaining in deck: {{ num_remaining }}</p>

<div class="card-grid">
{% for card in cards %}
    <span class="card {{ card.color }}">{{ card.symbol }}</span>
{% endfor %}
</div>

<p>
    <a href="{{ path('card_deck') }}">Sorted deck</a> |
    <a href="{{ path('deck_shuffle') }}">Shuffle</a> |
    <a href="{{ path('deck_draw') }}">Draw one</a>
</p>
</div>


{% endblock %}